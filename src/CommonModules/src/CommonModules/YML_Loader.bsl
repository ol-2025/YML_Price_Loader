&НаСервере
Процедура ЗаписатьПартнераНаСервере()
	
	Если Объект.Поставщик.Пустая() Тогда
		Сообщить("Поставщик не выбран");
		Возврат;
	КонецЕсли;
	ПартнерДляИзменения = Объект.Поставщик.ПолучитьОбъект();
	ПартнерДляИзменения.СсылкаYML            = Объект.СсылкаYML;
	ПартнерДляИзменения.YML_ТегТовара        = Объект.YML_ТегТовара;
	ПартнерДляИзменения.Артикул              = Объект.Артикул;
	ПартнерДляИзменения.Номенклатура         = Объект.Номенклатура;
	ПартнерДляИзменения.ЦенаНовая            = Объект.ЦенаНовая;
	ПартнерДляИзменения.Остатки              = Объект.Остатки;
	ПартнерДляИзменения.СпецЦена             = Объект.СпецЦена;
	ПартнерДляИзменения.ЦенаПоступления      = Объект.ЦенаПоступления;
	ПартнерДляИзменения.ПрефиксНоменклатуры  = Объект.ПрефиксНоменклатуры;
	ПартнерДляИзменения.Записать();
	
	Сообщить("Настройки YML сохранены для поставщика: " + Объект.Поставщик.Наименование);
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьПартнера(Команда)
	ЗаписатьПартнераНаСервере();
КонецПроцедуры


