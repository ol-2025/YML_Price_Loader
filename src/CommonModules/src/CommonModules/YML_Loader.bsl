&НаКлиенте
Процедура Загрузить(Команда)
	Если ПустаяСтрока(Объект.СсылкаYML) Тогда
		Сообщить("Введите ссылку на YML файл");
		Возврат;
	КонецЕсли;
	
	Объект.Цены.Очистить();
	ЗагрузитьYMLНаСервере(Объект.СсылкаYML);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьYMLНаСервере(СсылкаYML)
	
	Если Найти(СсылкаYML, "https://") > 0 Тогда
		ПозПротокола = 8; // позиция после https://
		Протокол = "https://";
	ИначеЕсли Найти(СсылкаYML, "http://") > 0 Тогда
		ПозПротокола = 7; // позиция после http://
		Протокол = "http://";
	Иначе
		ПозПротокола = 0;
		Протокол = "";
	КонецЕсли;
	
	//  хост
	ОстатокСсылки = Сред(СсылкаYML, ПозПротокола + 1);
	ПозПервогоСлеша = Найти(ОстатокСсылки, "/");
	Если ПозПервогоСлеша = 0 Тогда
		Хост = ОстатокСсылки;
		Путь = "/";
	Иначе
		Хост = Лев(ОстатокСсылки, ПозПервогоСлеша - 1);
		Путь = Сред(ОстатокСсылки, ПозПервогоСлеша);
	КонецЕсли;
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение(Хост,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		HTTPЗапрос = Новый HTTPЗапрос(Путь);
		HTTPЗапрос.Заголовки.Вставить("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36");
		
		ИмяФайла = ПолучитьИмяВременногоФайла(".xml");
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос, ИмяФайла);
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			
			Сообщить("Ошибка скачивания: Код " + HTTPОтвет.КодСостояния);
			Возврат;
		КонецЕсли;
		
	Исключение
		Сообщить("Ошибка при скачивании: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	МассивТоваров = РазобратьYML(ИмяФайла);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
	Для Каждого Товар Из МассивТоваров Цикл
		НоваяСтрока = Объект.Цены.Добавить();
		НоваяСтрока.Артикул = Товар.Артикул;
		НоваяСтрока.Наименование = Товар.Наименование;
		НоваяСтрока.Цена = Товар.Цена;
		НоваяСтрока.Остатки = ?(Товар.Свойство("Остатки"), Товар.Остатки, 0);
		//НоваяСтрока.Остатки = Товар.Остатки,;
		НоваяСтрока.СпецЦена = ?(Товар.Свойство("СпецЦена"), Товар.СпецЦена, 0);
		НоваяСтрока.ЦенаПоступления = ?(Товар.Свойство("ЦенаПоступления"), Товар.ЦенаПоступления, 0);		
	КонецЦикла;
	Объект.Коментарий = "Загружено товаров: " + МассивТоваров.Количество();
	
	
КонецПроцедуры

&НаСервере
Функция РазобратьYML(ПутьКФайлу)
	УникальныеАртикулы = Новый Соответствие;
	
	МассивТоваров = Новый Массив;
	ТегЦенаПоступления = Объект.ЦенаПоступления;
	ТегТовара      = Объект.YML_ТегТовара;
	ТегАртикула    = Объект.Артикул;
	ТегНаименования = Объект.Номенклатура;
	ТегЦены        = Объект.ЦенаНовая;
	ТегОстатки     = Объект.Остатки;
	ТегСпецЦена    = Объект.СпецЦена;
	Ссылка = Объект.Поставщик;
	
	
	Если ПустаяСтрока(ТегТовара) Тогда
		Сообщить("Ошибка: не заполнен тег товара");
		Возврат МассивТоваров;
	КонецЕсли;
	
	Если ПустаяСтрока(ТегАртикула) Тогда
		Сообщить("Ошибка: не заполнен тег артикула");
		Возврат МассивТоваров;
	КонецЕсли;
	
	Если ПустаяСтрока(ТегЦены) Тогда
		Сообщить("Ошибка: не заполнен тег цены");
		Возврат МассивТоваров;
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ПутьКФайлу);
		
		Пока Чтение.Прочитать() Цикл
			// Ищем тег товара (offer / product / item)
			//
			
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя = ТегТовара Тогда
				//
				ЗначениеAvailable = Чтение.ПолучитьАтрибут("available");
				//
				Товар = Новый Структура;
				Товар.Вставить("Артикул", "");
				Товар.Вставить("Наименование", "");
				Товар.Вставить("Цена", 0);
				Товар.Вставить("Остатки", 0);
				Товар.Вставить("СпецЦена", 0);
				Товар.Вставить("ЦенаПоступления", 0);
				
				Если ЗначениеAvailable = "true" Тогда
					Товар.Остатки = 5;   
				Иначе
					Товар.Остатки = 0;
				КонецЕсли;
				
				// Читаем внутренние теги
				Пока Чтение.Прочитать() Цикл
					Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = ТегТовара Тогда
						Прервать;
					КонецЕсли;
					
					Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
						
						Если Чтение.Имя = ТегАртикула Тогда
							Чтение.Прочитать();
							Товар.Артикул = СокрЛП(Чтение.Значение);
							
						ИначеЕсли Не ПустаяСтрока(ТегНаименования) И Чтение.Имя = ТегНаименования Тогда
							Чтение.Прочитать();
							Товар.Наименование = СокрЛП(Чтение.Значение);
							
						ИначеЕсли Чтение.Имя = ТегЦены Тогда
							Чтение.Прочитать();
							ЗначениеЦены = Чтение.Значение;
							Если ЗначениеЦены = Неопределено ИЛИ ПустаяСтрока(ЗначениеЦены) Тогда
								Товар.Цена = 0;
							Иначе
								//Товар.Цена = Число(ЗначениеЦены);   //четыри
								Товар.Цена = Окр(Число(ЗначениеЦены), 0,1);
							КонецЕсли;
							
						ИначеЕсли Чтение.Имя = ТегОстатки Тогда
							Чтение.Прочитать();
							ЗначениеОстатки = Чтение.Значение;
							//
							// Удаляем символы, которые мешают преобразованию в число
							ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, "≥", "");
							ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, "≤", "");
							ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, ">", "");
							ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, "<", "");
							ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, "=", "");
							ЗначениеОстатки = СокрЛП(ЗначениеОстатки);
							Если ТипЗнч(ЗначениеОстатки) = Тип("Строка") тогда  
								Попытка
									ЗначениеОстатки = Число(ЗначениеОстатки);
									Товар.Остатки = ЗначениеОстатки;
								Исключение
									//Товар.Остатки = ЗначениеОстатки;
								КонецПопытки;
							КонецЕсли;
							
							
							Если ЗначениеОстатки = Неопределено ИЛИ ПустаяСтрока(ЗначениеОстатки)  Тогда
								Товар.Остатки = 0;
							Иначе
								//  остатки передаются как "Y" или "N"
								Если ЗначениеОстатки = "Y" ИЛИ ЗначениеОстатки = "y" Тогда
									Товар.Остатки = 5;
								ИначеЕсли ЗначениеОстатки = "N" ИЛИ ЗначениеОстатки = "n" Тогда
									Товар.Остатки = 0;
								КонецЕсли;
							КонецЕсли;
							
							Если ЗначениеОстатки = "1 шт"   Тогда
								Товар.Остатки = 1;
							ИначеЕсли 
								ЗначениеОстатки = "В наличии" или ЗначениеОстатки = "есть в наличии" Тогда
								Товар.Остатки = 5;
							ИначеЕсли ЗначениеОстатки = "Под заказ" ИЛИ ЗначениеОстатки = Неопределено Тогда
								Товар.Остатки = 0;
								
							КонецЕсли;
							
							// СпецЦена    //это rrc_before_discount не перепутать не будет работать
						ИначеЕсли Чтение.Имя = ТегСпецЦена Тогда
							Чтение.Прочитать();
							ЗначениеСпецЦены = Чтение.Значение;
							Если ЗначениеСпецЦены = Неопределено ИЛИ ПустаяСтрока(ЗначениеСпецЦены) Тогда
								Товар.СпецЦена = 0;
							Иначе
								Товар.СпецЦена = Окр(Число(ЗначениеСпецЦены), 0,1);
							КонецЕсли;
							
							// ЦенаПоступления
						ИначеЕсли Чтение.Имя = ТегЦенаПоступления Тогда
							Чтение.Прочитать();
							ЗначениеЦеныПоступления = Чтение.Значение;
							Если ЗначениеЦеныПоступления = Неопределено ИЛИ ПустаяСтрока(ЗначениеЦеныПоступления) Тогда
								Товар.ЦенаПоступления = 0;
							Иначе
								Товар.ЦенаПоступления = Окр(Число(ЗначениеЦеныПоступления), 0,1);
							КонецЕсли;
							
						ИначеЕсли Чтение.Имя = "param" Тогда
							ИмяПараметра = Чтение.ПолучитьАтрибут("name");
							
							// Спеццена (если передаётся через param)
							Если Не ПустаяСтрока(ТегСпецЦена) И ИмяПараметра = ТегСпецЦена Тогда
								Чтение.Прочитать();
								ЗначениеСпецЦены = Чтение.Значение;
								Если ЗначениеСпецЦены <> Неопределено И Не ПустаяСтрока(ЗначениеСпецЦены) Тогда
									//Товар.СпецЦена = Число(ЗначениеСпецЦены);  //Два
									Товар.СпецЦена = Окр(Число(ЗначениеСпецЦены), 0);
									
								КонецЕсли;
								
								// Цена поступления (если передаётся через param)
							ИначеЕсли Не ПустаяСтрока(ТегЦенаПоступления) И ИмяПараметра = ТегЦенаПоступления Тогда
								Чтение.Прочитать();
								ЗначениеЦеныПоступления = Чтение.Значение;
								Если ЗначениеЦеныПоступления <> Неопределено И Не ПустаяСтрока(ЗначениеЦеныПоступления) Тогда
									Товар.ЦенаПоступления = Окр(Число(ЗначениеЦеныПоступления), 0);
									
								КонецЕсли;
								
								// Остатки (если передаются через param)
							ИначеЕсли Не ПустаяСтрока(ТегОстатки) И ИмяПараметра = ТегОстатки Тогда
								Чтение.Прочитать();
								ЗначениеОстатки = Чтение.Значение;
								Если ЗначениеОстатки <> Неопределено И Не ПустаяСтрока(ЗначениеОстатки) Тогда
									ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, "≥", "");
									ЗначениеОстатки = СтрЗаменить(ЗначениеОстатки, "≤", "");
									Товар.Остатки = Число(ЗначениеОстатки);
								КонецЕсли;
								
							КонецЕсли;								
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Если ПустаяСтрока(Товар.Артикул) И ПустаяСтрока(Товар.Наименование) И Товар.Цена <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПустаяСтрока(Товар.Артикул) Тогда
					Продолжить;
				КонецЕсли;
				
				//
				Если УникальныеАртикулы.Получить(Товар.Артикул) = Неопределено Тогда
					УникальныеАртикулы.Вставить(Товар.Артикул, Истина);
					МассивТоваров.Добавить(Товар);
				КонецЕсли;
				// 
				
				Если Товар.Цена <= 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Чтение.Закрыть();
		
	Исключение
		Сообщить("Ошибка парсинга YML: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат МассивТоваров;
	
КонецФункции

&НаСервере
Функция ОстаткиНашейНоменклатуры()
	МассивОстатков = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|ГДЕ
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивОстатков.Добавить(Выборка.Номенклатура);	
	КонецЦикла;
	
	Возврат МассивОстатков;
КонецФункции 

&НаСервере
Процедура СопоставитьСБазойНаСервере()
	
	АртикулыИзYML        = Новый Массив;
	//Префикс = "1086-"; ---дсн
	Префикс              = Объект.ПрефиксНоменклатуры;
	Для Каждого СтрокаТЗ Из Объект.Цены Цикл
		Артикул          = Префикс + СтрокаТЗ.Артикул;
		СтрокаТЗ.Артикул =  Артикул;
		АртикулыИзYML.Добавить(Артикул);
	КонецЦикла;	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыПоставщиковСОПОСрезПоследних.Цена,
	|	НоменклатураПоставщиков.Артикул КАК Артикул,
	|	НоменклатураПоставщиков.Наименование КАК Наименование,
	|	НоменклатураПоставщиков.Ссылка
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыПоставщиковСОПО.СрезПоследних КАК ЦеныНоменклатурыПоставщиковСОПОСрезПоследних
	|		ПО НоменклатураПоставщиков.Ссылка = ЦеныНоменклатурыПоставщиковСОПОСрезПоследних.Номенклатура
	|ГДЕ
	|	НоменклатураПоставщиков.Артикул В(&Артикул)";
	
	Запрос.УстановитьПараметр("Артикул", АртикулыИзYML);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СоответствиеБаза = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		ДанныеБазы = Новый Структура;
		ДанныеБазы.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеБазы.Вставить("Артикул", Выборка.Артикул);
		ДанныеБазы.Вставить("Наименование", Выборка.Наименование);
		ДанныеБазы.Вставить("Цена", Выборка.Цена);
		СоответствиеБаза.Вставить(Выборка.Артикул, Выборка);
		
	КонецЦикла;
	
	
	МассивДляОбновленияЦен      = Новый Массив;
	МассивДляОбновленияОстатков = Новый Массив;
	
	Для Каждого СтрокаТЗ Из Объект.Цены Цикл
		
		СтрокаБазы         = СоответствиеБаза.Получить(СтрокаТЗ.Артикул);
		
		Если СтрокаБазы    = Неопределено Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если СтрокаБазы <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	НоменклатураПоставщиков.Ссылка,
			|	НоменклатураПоставщиков.Артикул
			|ИЗ
			|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
			|ГДЕ
			|	НоменклатураПоставщиков.Артикул = &Артикул";
			
			Запрос.УстановитьПараметр("Артикул", СтрокаТЗ.Артикул);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				СсылкаНаТовар = Выборка.Ссылка;
				СтрокаТЗ.Цвет = "ЦЕНА ОБНОВЛЕНА!";
			КонецЦикла;
			
			//
			Если МассивДляОбновленияЦен.Найти(Новый Структура("Номенклатура", СсылкаНаТовар)) = Неопределено Тогда
				МассивДляОбновленияЦен.Добавить(Новый Структура("Номенклатура, ЦенаНовая, ЦенаПоступления, СпецЦена, Остатки",
				СсылкаНаТовар, СтрокаТЗ.Цена,СтрокаТЗ.ЦенаПоступления,СтрокаТЗ.СпецЦена,СтрокаТЗ.Остатки));
				
			КонецЕсли;
			
			МассивДляОбновленияОстатков.Добавить(Новый Структура("Номенклатура, Количество",СсылкаНаТовар,СтрокаТЗ.Остатки));
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДляОбновленияЦен.Количество() > 0 Тогда
		
		//Запись документ// не забыть попытку!!!!!!
		Попытка
			ДокументЦены             = Документы.РегистрацияЦенПоставщиковСОПО.СоздатьДокумент();
			ДокументЦены.Дата        = ТекущаяДата();
			ДокументЦены.Поставщик   = Объект.Поставщик;
			ДокументЦены.Комментарий = "Ручная загрузка из YML от " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm");
			
			Для Каждого Изменение Из МассивДляОбновленияЦен Цикл
				СтрокаТовара              = ДокументЦены.Товары.Добавить();
				СтрокаТовара.ЦенаПоступления = Изменение.ЦенаПоступления;
				СтрокаТовара.Номенклатура = Изменение.Номенклатура;
				СтрокаТовара.Цена         = Изменение.ЦенаНовая;
				СтрокаТовара.СпецЦена     = Изменение.СпецЦена;
				
				//
				СтрокаТовара.ВалютаЦены = Справочники.Валюты.НайтиПоКоду("980");
				СтрокаТовара.КурсЦены = 1;
				СтрокаТовара.КурсЦеныПоступления = 1;
				
				
			КонецЦикла;
			
			ДокументЦены.Записать(РежимЗаписиДокумента.Проведение);
			НомерДокумента    =  ДокументЦены.Номер;
			Объект.Коментарий = Объект.Коментарий + Символы.ПС +  "Для "+" "+СоответствиеБаза.Количество()+ "товаров"+" "+"обновилась цена: "+ Символы.ПС +"Создан документ регистрация цен поставщиков СОПО №"+" "+НомерДокумента;
			
			ЗаписьЖурналаРегистрации("YML загрузка", УровеньЖурналаРегистрации.Информация,,, 
			"Поставщик: " + Объект.Поставщик + " Документ №" + НомерДокумента);
			
		Исключение
			ЗаписьЖурналаРегистрации("Ошибка записи документа цен", УровеньЖурналаРегистрации.Ошибка,,, 
			"Поставщик: " + Объект.Поставщик + " Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
	//Остатки потом проверить не забыть!!..
	Если МассивДляОбновленияОстатков.Количество() > 0 Тогда
		Попытка
			ДокументОстатки = Документы.РегистрацияОстатковТоваровПоставщикаСОПО.СоздатьДокумент();
			ДокументОстатки.Дата = ТекущаяДата();
			ДокументОстатки.Поставщик = Объект.Поставщик;
			ДокументОстатки.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			ДокументОстатки.Комментарий = "Ручная загрузка из YML от " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm");
			
			Для Каждого Изменение Из МассивДляОбновленияОстатков Цикл
				СтрокаТовара = ДокументОстатки.Товары.Добавить();
				СтрокаТовара.Номенклатура = Изменение.Номенклатура;
				СтрокаТовара.Количество = Изменение.Количество;
			КонецЦикла;
			
			ДокументОстатки.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			ЗаписьЖурналаРегистрации("YML загрузка", УровеньЖурналаРегистрации.Информация,,, 
			"Поставщик: " + Объект.Поставщик + " Обновлено остатков: " + МассивДляОбновленияОстатков.Количество());
			
		Исключение
			ЗаписьЖурналаРегистрации("Ошибка записи документа остатков", УровеньЖурналаРегистрации.Ошибка,,, 
			"Поставщик: " + Объект.Поставщик + " Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	СтрокаОбновления = "Обновлено остатков: " + МассивДляОбновленияОстатков.Количество();
	Объект.Коментарий = Объект.Коментарий +Символы.ПС+ СтрокаОбновления; 
	
	Если МассивДляОбновленияЦен.Количество()  =  0  Тогда
		Объект.Коментарий = Объект.Коментарий + "Документ не создан соответствия не найдены;"+Символы.ПС +"  проверьте коректность введенных реквизитов!!!"
		
	КонецЕсли;
	 //серпень2026
	Если Объект.Цены.Количество()>0 Тогда
	 Элементы.ФормаСопоставитьСБазой.Доступность = Ложь;
	КонецЕсли; 
	
КонецПроцедуры

