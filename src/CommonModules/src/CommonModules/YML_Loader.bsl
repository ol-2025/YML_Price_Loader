&НаСервере
Процедура ПоставщикПриИзмененииНаСервере()
	Элементы.ФормаСопоставитьСБазой.Доступность = Истина;
	Объект.Цены.Очистить();
	Объект.Коментарий = "";
	Если Объект.Поставщик.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПоставщикОбъект            = Объект.Поставщик.ПолучитьОбъект();
	Объект.СсылкаYML           = ПоставщикОбъект.СсылкаYML;
	Объект.YML_ТегТовара       = ПоставщикОбъект.YML_ТегТовара;
	Объект.Артикул             = ПоставщикОбъект.Артикул;
	Объект.Номенклатура        = ПоставщикОбъект.Номенклатура;
	Объект.ЦенаНовая           = ПоставщикОбъект.ЦенаНовая;
	Объект.Остатки             = ПоставщикОбъект.Остатки;
	Объект.ПрефиксНоменклатуры = ПоставщикОбъект.ПрефиксНоменклатуры;
	Объект.ЦенаПоступления     = ПоставщикОбъект.ЦенаПоступления;
	Объект.СпецЦена            = ПоставщикОбъект.СпецЦена;
	
КонецПроцедуры


&НаКлиенте
Процедура ПоставщикПриИзменении(Элемент)
	ПоставщикПриИзмененииНаСервере();
